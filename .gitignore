# =============================================================================
# Rust / Cargo
# =============================================================================

# Build artifacts
/target
**/target/

# Cargo lock file (keep for binaries, ignore for libraries)
# This is a binary project (WASM), so we keep Cargo.lock
# Uncomment the next line if this becomes a library
# Cargo.lock

# Backup files created by rustfmt or editor
*.rs.bk
*.rs.orig

# Profiling data
*.profdata
*.profraw

# =============================================================================
# WASM / wasm-bindgen / wasm-pack
# =============================================================================

# wasm-pack build output
/pkg
/pkg-*/

# Generated WASM files
*.wasm
!tests/fixtures/**/*.wasm  # Keep test fixtures if any

# Generated JavaScript bindings (if generated to separate dir)
/wasm_dist
/wasm-out

# =============================================================================
# Node.js / npm / www directory
# =============================================================================

# Dependencies
/www/node_modules/
node_modules/

# Build outputs
/www/dist/
/www/build/
/www/out/
dist/
build/
out/

# Next.js / Vite / other framework outputs
/www/.next/
/www/.nuxt/
/www/.output/
.next/
.nuxt/
.output/

# Static site generators
/www/_site/
/www/.cache/
_site/
.cache/

